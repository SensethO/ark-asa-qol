<?xml version="1.0" encoding="utf-8"?>
<!--
  Injected via /p:ForceImportBeforeCppTargets so neither the AsaApi submodule nor the
  plugin project has to be edited. Supplies fmt in header-only mode, replacing the
  vcpkg dependency declared in vcpkg.json.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\extern\fmt\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>FMT_HEADER_ONLY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
  </PropertyGroup>
</Project>
